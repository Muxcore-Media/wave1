# Golden MuxCore module CI template (Wave 1)
# Placeholders: {{MODULE}}, and optional sibling checkout blocks from ci-siblings.json
name: CI
on:
  push:
    branches: [master, main]
  pull_request:
    branches: [master, main]

env:
  REGISTRY: ghcr.io
  IMAGE_NAME: ${{ github.repository }}

jobs:
  lint:
    runs-on: [self-hosted, Linux, X64]
    steps:
{{CHECKOUTS}}
      - uses: actions/setup-go@v6
        with:
          go-version: "1.26"
          cache: true
      - uses: golangci/golangci-lint-action@v9
        with:
          version: latest
          working-directory: ./{{MODULE}}
          args: --timeout 120s

  test:
    runs-on: [self-hosted, Linux, X64]
    steps:
{{CHECKOUTS}}
      - uses: actions/setup-go@v6
        with:
          go-version: "1.26"
          cache: true
      - working-directory: ./{{MODULE}}
        run: go test -race -count=1 -timeout 60s ./...

  build:
    runs-on: [self-hosted, Linux, X64]
    steps:
{{CHECKOUTS}}
      - uses: actions/setup-go@v6
        with:
          go-version: "1.26"
          cache: true
      - working-directory: ./{{MODULE}}
        run: |
          if [ -d cmd/module ]; then go build -o /dev/null ./cmd/module
          elif [ -d cmd ]; then go build -o /dev/null ./cmd/...
          else go build -o /dev/null ./...
          fi
          go vet ./...

  docker:
    if: (github.ref == 'refs/heads/master' || github.ref == 'refs/heads/main')
    runs-on: [self-hosted, Linux, X64]
    needs: [lint, test, build]
    steps:
{{CHECKOUTS}}
      - uses: docker/setup-buildx-action@v3
      - uses: docker/login-action@v4
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - uses: docker/build-push-action@v7
        with:
          context: .
          file: ./{{MODULE}}/Dockerfile
          push: true
          tags: ${{ env.REGISTRY }}/${{ github.repository }}:${{ github.sha }}
